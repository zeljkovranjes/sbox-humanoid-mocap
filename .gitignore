.venv/
**/bin/
**/obj/
**/__pycache__/
docs/research/
dev/verification/
.bin/
Code/*.csproj
Editor/*.csproj
Code/Properties/
Editor/Properties/
*.user

# Local development only: never publish these with the library.
dev/
tests/
# Only the C# inference worker under worker/ is published; anything else there stays local.
worker/*
!worker/InferenceWorker/
Editor/MocapSmokeGate.cs
.sbox/
.vs/
**/uploads/
*.sln
*.slnx

# Working notes, measurements and setup details stay local. Only the package
# README, the third-party notices (required attribution) and the changelog are published.
*.md
!/README.md
!/THIRD_PARTY_NOTICES.md
!/CHANGELOG.md

# Tool and editor leftovers
.claude/
*.log
*.tmp
*.partial
*.bak
Thumbs.db
.DS_Store
bin/
obj/
# generated by the s&box editor when this package is mounted
**/TestResults/
__pycache__/
dev/data/
dev/out/
.claude/settings.local.json
DISCORD.md
CLAUDE.md
DEVLOG.md
